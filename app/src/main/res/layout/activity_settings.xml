<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/sec_tts" />

        <!-- ============ API profile ============ -->
        <TextView
            android:id="@+id/tvProfileTitle"
            style="@style/FieldLabel"
            android:text="@string/profile_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spProfile"
                style="@style/FieldInput"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnRenameProfile"
                style="@style/ProfileSideButton"
                android:text="@string/profile_rename" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddProfile"
                style="@style/ProfAction"
                android:text="@string/profile_add" />

            <Button
                android:id="@+id/btnDupProfile"
                style="@style/ProfAction"
                android:text="@string/profile_dup" />

            <Button
                android:id="@+id/btnDelProfile"
                style="@style/ProfAction"
                android:text="@string/profile_del" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/profile_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/tts_base" />

        <EditText
            android:id="@+id/etBase"
            style="@style/FieldInput"
            android:hint="@string/tts_base_hint"
            android:inputType="textUri" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/tts_key" />

        <EditText
            android:id="@+id/etKey"
            style="@style/FieldInput"
            android:hint="@string/tts_key_hint"
            android:inputType="textPassword" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/tts_model" />

        <EditText
            android:id="@+id/etModel"
            style="@style/FieldInput"
            android:hint="@string/tts_model_hint"
            android:inputType="text" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/tts_voice" />

        <EditText
            android:id="@+id/etVoice"
            style="@style/FieldInput"
            android:hint="@string/tts_voice_hint"
            android:inputType="text" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/tts_speed" />

        <EditText
            android:id="@+id/etSpeed"
            style="@style/FieldInput"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/tts_speed_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/tts_timeout" />

        <EditText
            android:id="@+id/etTimeout"
            style="@style/FieldInput"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/tts_timeout_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/setting_chunk" />

        <Spinner
            android:id="@+id/spChunk"
            style="@style/FieldInput" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/setting_chunk_custom" />

        <EditText
            android:id="@+id/etChunkChars"
            style="@style/FieldInput"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/chunk_custom_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/setting_preload" />

        <EditText
            android:id="@+id/etPreloadMin"
            style="@style/FieldInput"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/preload_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnTest"
            style="@style/BarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tts_test" />

        <Button
            android:id="@+id/btnPullModels"
            style="@style/BarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pull_models" />

        <TextView
            android:id="@+id/tvTestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/sec_cache" />

        <TextView
            android:id="@+id/tvCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCachePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnClearCache"
            style="@style/BarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cache_clear" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/sec_reading" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/setting_theme" />

        <Spinner
            android:id="@+id/spTheme"
            style="@style/FieldInput" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/setting_font_size" />

        <EditText
            android:id="@+id/etFontSize"
            style="@style/FieldInput"
            android:inputType="number" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/setting_line_spacing" />

        <EditText
            android:id="@+id/etLineSpacing"
            style="@style/FieldInput"
            android:inputType="numberDecimal" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/setting_margin" />

        <EditText
            android:id="@+id/etMargin"
            style="@style/FieldInput"
            android:inputType="number" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/setting_font_family" />

        <Spinner
            android:id="@+id/spFont"
            style="@style/FieldInput" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setting_auto_scroll"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/swAutoScroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/accent"
            android:text="@string/settings_save"
            android:textColor="@color/bg"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReset"
            style="@style/BarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/settings_reset" />
    </LinearLayout>
</ScrollView>
